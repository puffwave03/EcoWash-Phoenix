# Replace with the canonical public domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase public project settings.
# The anon key is safe for browser use only when RLS policies are enabled.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key

# Server-only Supabase secrets must never use the NEXT_PUBLIC_ prefix.
# SUPABASE_SERVICE_ROLE_KEY is intentionally not required by APP-003 client code.
